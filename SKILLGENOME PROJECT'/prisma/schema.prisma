datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String   @id @default(uuid())
  fullName         String
  username         String   @unique
  email            String   @unique
  passwordHash     String
  profileImage     String?
  bio              String?
  githubUsername   String?
  linkedinUrl      String?
  portfolioUrl     String?
  experienceLevel  String   @default("CS Student")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  skills           Skill[]
  projects         Project[]
  githubStats      GithubStats?
  codingTracker    CodingTracker?
  aiAnalysis       AiAnalysis?
  roadmaps         Roadmap[]
  interviewResults InterviewResult[]
  achievements     Achievement[]
  settings         Setting?
}

model Skill {
  id              String   @id @default(uuid())
  userId          String
  skillName       String
  skillLevel      String   // e.g. "Beginner", "Intermediate", "Advanced"
  confidenceScore Float    @default(0.0)
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id             String   @id @default(uuid())
  userId         String
  title          String
  description    String
  githubLink     String?
  liveDemo       String?
  techStack      String   // Comma-separated or serialized array
  aiProjectScore Float    @default(0.0)
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GithubStats {
  id                String   @id @default(uuid())
  userId            String   @unique
  commits           Int      @default(0)
  repositories      Int      @default(0)
  contributionScore Float    @default(0.0)
  codingConsistency Float    @default(0.0)
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CodingTracker {
  id              String   @id @default(uuid())
  userId          String   @unique
  codingHours     Float    @default(0.0)
  dailyProgress   Float    @default(0.0)
  streakCount     Int      @default(0)
  dsaScore        Int      @default(0)
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiAnalysis {
  id                  String   @id @default(uuid())
  userId              String   @unique
  developerDnaScore   Int      @default(0)
  aiReadiness         Int      @default(0)
  hiringProbability   String   // JSON string of { faang, unicorns, startups }
  weaknessReport      String   // JSON string of weaknesses array [{topic, description, impact}]
  careerPrediction    String
  salaryPrediction    String   // JSON string of {currency, predictedMin, predictedMax, timeToMaxMonths}
  dnaSequence         String   @default("ACTG-TTA-GGC")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Roadmap {
  id                 String   @id @default(uuid())
  userId             String
  title              String
  estimatedCompletion String
  milestones         String   // JSON string representing roadmap milestones/phases
  weeklyTargets      String?  // JSON string
  learningPaths      String?  // JSON string
  createdAt          DateTime @default(now())

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InterviewResult {
  id                 String   @id @default(uuid())
  userId             String
  technicalScore     Int      @default(0)
  communicationScore Int      @default(0)
  confidenceScore    Int      @default(0)
  aiFeedback         String
  createdAt          DateTime @default(now())

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id             String   @id @default(uuid())
  userId         String
  xpPoints       Int      @default(0)
  badges         String   // Seriailzed badges array
  leaderboardRank Int     @default(0)
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Setting {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  theme                  String   @default("dark")
  notificationPreferences String   @default("email,push") // comma separated CSV
  privacySettings        String   @default("public")
  aiPreferences          String   @default("balanced")
  selected_country       String   @default("USA")
  currency_code          String   @default("USD")
  locale                 String   @default("en-US")
  timezone               String   @default("America/New_York")
  salary_format          String   @default("yearly")
  auto_detect_currency   Boolean  @default(true)
  updatedAt              DateTime @updatedAt

  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
